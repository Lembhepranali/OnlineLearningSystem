        public List<CourseTable> GetByCategory(string categoryName)
        {
            List<CourseTable> list = new List<CourseTable>();

            using (sqlcon = new SqlConnection(con))
            {
                string query = @"
            SELECT c.*
            FROM CourseTable c
            INNER JOIN Category cat
                ON c.CategoryId = cat.CategoryId
            WHERE cat.CategoryName = @categoryName";

                sqlcmd = new SqlCommand(query, sqlcon);
                sqlcmd.Parameters.AddWithValue("@categoryName", categoryName);

                sqlcon.Open();
                dataReader = sqlcmd.ExecuteReader();

                while (dataReader.Read())
                {
