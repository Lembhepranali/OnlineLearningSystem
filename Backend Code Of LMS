using System;
using System.Collections.Generic;
using System.Web.Http;
using System.Configuration;
using System.Data.SqlClient;
using OnlineLearningSystem.Models;


namespace OnlineLearningSystem.Controllers
{
    [RoutePrefix("api/User")]
    public class UserController : ApiController
    {
        SqlConnection sqlcon;
        SqlCommand sqlcmd;
        SqlDataReader dataReader;

        string con = ConfigurationManager.ConnectionStrings["conStr"].ConnectionString;
        // ================= GET ALL USERS =================

        [HttpGet]
        [Route("GetAll")]
        public List<UserDetails> GetUsers()
        {
            List<UserDetails> list = new List<UserDetails>();

            using (sqlcon = new SqlConnection(con))
            {
                string query = "SELECT * FROM UserDetails";

                sqlcmd = new SqlCommand(query, sqlcon);

                sqlcon.Open();

                dataReader = sqlcmd.ExecuteReader();

                while (dataReader.Read())
                {
                    UserDetails user = new UserDetails();

                    user.UserID = Convert.ToInt32(dataReader["UserID"]);
                    user.UserName = dataReader["UserName"].ToString();
                    user.UserEmail = dataReader["UserEmail"].ToString();
                    user.UserPassword = dataReader["UserPassword"].ToString();
                    user.UserConfirmPassword = dataReader["UserConfirmPassword"].ToString();
                    user.TypeId = Convert.ToInt32(dataReader["TypeId"]);

                    list.Add(user);
                }
            }

            return list;
        }
        // ================= REGISTER USER =================

        [HttpPost]
        [Route("Register")]
        public string Register(UserDetails user)
        {
            try
            {
                // Password Validation
                if (user.UserPassword != user.UserConfirmPassword)
                {
                    return "Password and Confirm Password do not match";
                }

                using (sqlcon = new SqlConnection(con))
                {
                    sqlcon.Open();

                    // Check Email Exists
                    string checkQuery =
                        "SELECT COUNT(*) FROM UserDetails WHERE UserEmail=@email";

                    sqlcmd = new SqlCommand(checkQuery, sqlcon);

                    sqlcmd.Parameters.AddWithValue("@email", user.UserEmail);

                    int count = Convert.ToInt32(sqlcmd.ExecuteScalar());

                    if (count > 0)
                    {
                        return "Email Already Exists";
                    }

                    // Insert User
                    string query = @"INSERT INTO UserDetails
                    (UserName, UserEmail, UserPassword, UserConfirmPassword, TypeId)
                    VALUES
                    (@name,@email,@password,@confirmpassword,@typeid)";

                    sqlcmd = new SqlCommand(query, sqlcon);

                    sqlcmd.Parameters.AddWithValue("@name", user.UserName);
                    sqlcmd.Parameters.AddWithValue("@email", user.UserEmail);
                    sqlcmd.Parameters.AddWithValue("@password", user.UserPassword);
                    sqlcmd.Parameters.AddWithValue("@confirmpassword", user.UserConfirmPassword);
                    sqlcmd.Parameters.AddWithValue("@typeid", user.TypeId);

                    sqlcmd.ExecuteNonQuery();
                }

                return "Registration Successful";
            }
            catch (Exception ex)
            {
                return ex.Message;
            }
        }

        // ================= LOGIN =================

        [HttpPost]
        [Route("Login")]
        public IHttpActionResult Login(UserDetails user)
        {
            try
            {
                using (sqlcon = new SqlConnection(con))
                {
                    string query = @"SELECT * FROM UserDetails
                                     WHERE UserEmail=@email
                                     AND UserPassword=@password";

                    sqlcmd = new SqlCommand(query, sqlcon);

                    sqlcmd.Parameters.AddWithValue("@email", user.UserEmail);
                    sqlcmd.Parameters.AddWithValue("@password", user.UserPassword);

                    sqlcon.Open();

                    dataReader = sqlcmd.ExecuteReader();

                    if (dataReader.Read())
                    {
                        return Ok(new
                        {
                            UserID = dataReader["UserID"],
                            UserName = dataReader["UserName"],
                            UserEmail = dataReader["UserEmail"],
                            TypeId = dataReader["TypeId"]
                        });
                    }
                    else
                    {
                        return BadRequest("Invalid Email or Password");
                    }
                }
            }
            catch (Exception ex)
            {
                return BadRequest(ex.Message);
            }
        }
        // ================= UPDATE USER =================

        [HttpPut]
        [Route("Update")]
        public string UpdateUser(UserDetails user)
        {
            using (sqlcon = new SqlConnection(con))
            {
                string query = @"UPDATE UserDetails
                                 SET UserName=@name,
                                 UserEmail=@email
                                 WHERE UserID=@id";

                sqlcmd = new SqlCommand(query, sqlcon);

                sqlcmd.Parameters.AddWithValue("@id", user.UserID);
                sqlcmd.Parameters.AddWithValue("@name", user.UserName);
                sqlcmd.Parameters.AddWithValue("@email", user.UserEmail);

                sqlcon.Open();

                sqlcmd.ExecuteNonQuery();
            }

            return "User Updated Successfully";
        }

        // ================= DELETE USER =================

        [HttpDelete]
        [Route("Delete/{id}")]
        public string DeleteUser(int id)
        {
            using (sqlcon = new SqlConnection(con))
            {
                string query =
                    "DELETE FROM UserDetails WHERE UserID=@id";

                sqlcmd = new SqlCommand(query, sqlcon);

                sqlcmd.Parameters.AddWithValue("@id", id);

                sqlcon.Open();

                sqlcmd.ExecuteNonQuery();
            }

            return "User Deleted Successfully";
        }


    }
}


