        [Route("GetByUser/{userid}")]
        public IHttpActionResult GetByUser(int userid)
        {
            try
            {
                using (sqlcon = new SqlConnection(con))
                {
                    sqlcon.Open();

                    string query = @"
            SELECT 
                c.CourId,
                c.CourName,
                c.CourPrice,
                c.CourImg,
                c.CourDsc,
                c.CategoryId,
                c.InstructorId
            FROM EnrollmentTable e
            INNER JOIN CourseTable c ON e.CourId = c.CourId
            WHERE e.UserId = @uid";

                    sqlcmd = new SqlCommand(query, sqlcon);
                    sqlcmd.Parameters.AddWithValue("@uid", userid);

                    SqlDataReader reader = sqlcmd.ExecuteReader();

                    var list = new System.Collections.Generic.List<CourseTable>();

                    while (reader.Read())
                    {
                        list.Add(new CourseTable
                        {
                            CourId = Convert.ToInt32(reader["CourId"]),
                            CourName = reader["CourName"].ToString(),
                            CourPrice = Convert.ToInt32(reader["CourPrice"]),
                            CourImg = reader["CourImg"].ToString(),
                            CourDsc = reader["CourDsc"].ToString(),
                            CategoryId = Convert.ToInt32(reader["CategoryId"]),
                            InstructorId = Convert.ToInt32(reader["InstructorId"])
                        });
                    }

                    return Ok(list);
                }
            }
            catch (Exception ex)
            {
                return BadRequest(ex.Message);
            }
        }

        // ================= ENROLL COURSE =================
        [HttpPost]
        [Route("Add")]
        public string AddEnrollment(EnrollmentTable e)
        {
            try
            {
                using (sqlcon = new SqlConnection(con))
                {
                    sqlcon.Open();

                    //  Check already enrolled
                    string checkQuery = @"
                    SELECT COUNT(*) 
                    FROM EnrollmentTable
                    WHERE UserId = @uid AND CourId = @cid";

                    sqlcmd = new SqlCommand(checkQuery, sqlcon);
                    sqlcmd.Parameters.AddWithValue("@uid", e.UserId);
                    sqlcmd.Parameters.AddWithValue("@cid", e.CourId);

                    int count = Convert.ToInt32(sqlcmd.ExecuteScalar());

                    if (count > 0)
                    {
                        return "Already Enrolled";
                    }

                    //  Insert enrollment
                    string query = @"
                    INSERT INTO EnrollmentTable (UserId, CourId)
                    VALUES (@uid, @cid)";

                    sqlcmd = new SqlCommand(query, sqlcon);

                    sqlcmd.Parameters.AddWithValue("@uid", e.UserId);
                    sqlcmd.Parameters.AddWithValue("@cid", e.CourId);

                    sqlcmd.ExecuteNonQuery();
                }

                return "Enrollment Successful";
            }
            catch (Exception ex)
            {
                return ex.Message;
            }
        }
    }
}

