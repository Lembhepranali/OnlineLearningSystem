using System;
using System.Collections.Generic;
using System.Web.Http;
using System.Configuration;
using System.Data.SqlClient;
using OnlineLearningSystem.Models;

namespace OnlineLearningSystem.Controllers
{
    [RoutePrefix("api/Cart")]
    public class CartController : ApiController
    {
        SqlConnection sqlcon;
        SqlCommand sqlcmd;
        SqlDataReader dataReader;

        string con = ConfigurationManager
                     .ConnectionStrings["conStr"]
                     .ConnectionString;

        // ================= GET USER CART =================

        [HttpGet]
        [Route("GetCart/{userid}")]
        public List<CourseTable> GetCart(int userid)
        {
            List<CourseTable> list = new List<CourseTable>();

            using (sqlcon = new SqlConnection(con))
            {
                string query = @"
                SELECT 
                    c.CourId,
                    c.CourName,
                    c.CourPrice,
                    c.CourImg,
                    c.CourDsc,
                    c.CategoryId,
                    c.InstructorId
                FROM CartTable ct
                INNER JOIN CourseTable c
                ON ct.CourId = c.CourId
                WHERE ct.UserId=@uid";

                sqlcmd = new SqlCommand(query, sqlcon);

                sqlcmd.Parameters.AddWithValue("@uid", userid);

                sqlcon.Open();

                dataReader = sqlcmd.ExecuteReader();

                while (dataReader.Read())
                {
                    CourseTable c = new CourseTable();

                    c.CourId = Convert.ToInt32(dataReader["CourId"]);
                    c.CourName = dataReader["CourName"].ToString();
                    c.CourPrice = Convert.ToInt32(dataReader["CourPrice"]);
                    c.CourImg = dataReader["CourImg"].ToString();
                    c.CourDsc = dataReader["CourDsc"].ToString();
                    c.CategoryId = Convert.ToInt32(dataReader["CategoryId"]);
                    c.InstructorId = Convert.ToInt32(dataReader["InstructorId"]);

                    list.Add(c);
                }
            }

            return list;
        }

        // ================= ADD TO CART =================

        [HttpPost]
        [Route("Add")]
        public string AddToCart(CartTable cart)
        {
            try
            {
                using (sqlcon = new SqlConnection(con))
                {
                    sqlcon.Open();

                    // Check Course Already Exists
                    string checkQuery = @"
                    SELECT COUNT(*) FROM CartTable
                    WHERE UserId=@uid AND CourId=@cid";

                    sqlcmd = new SqlCommand(checkQuery, sqlcon);

                    sqlcmd.Parameters.AddWithValue("@uid", cart.UserId);
                    sqlcmd.Parameters.AddWithValue("@cid", cart.CourId);

                    int count = Convert.ToInt32(sqlcmd.ExecuteScalar());

                    if (count > 0)
                    {
                        return "Course Already Added To Cart";
                    }

                    // Add To Cart
                    string query = @"
                    INSERT INTO CartTable(UserId,CourId)
                    VALUES(@uid,@cid)";

                    sqlcmd = new SqlCommand(query, sqlcon);

                    sqlcmd.Parameters.AddWithValue("@uid", cart.UserId);
                    sqlcmd.Parameters.AddWithValue("@cid", cart.CourId);

                    sqlcmd.ExecuteNonQuery();
                }

                return "Course Added To Cart";
            }
            catch (Exception ex)
            {
                return ex.Message;
            }
        }



        // ================= REMOVE FROM CART =================

        [HttpDelete]
        [Route("Delete/{userid}/{courseid}")]
        public string DeleteCartItem(int userid, int courseid)
        {
            try
            {
                using (sqlcon = new SqlConnection(con))
                {
                    string query = @"
                    DELETE FROM CartTable
                    WHERE UserId=@uid
                    AND CourId=@cid";

                    sqlcmd = new SqlCommand(query, sqlcon);

                    sqlcmd.Parameters.AddWithValue("@uid", userid);
                    sqlcmd.Parameters.AddWithValue("@cid", courseid);

                    sqlcon.Open();

                    sqlcmd.ExecuteNonQuery();
                }

                return "Course Removed From Cart";
            }
            catch (Exception ex)
            {
                return ex.Message;
            }
        }

        [HttpPost]
        [Route("BuyNow/{userId}")]
        public IHttpActionResult BuyNow(int userId)
        {
            try
            {
                using (SqlConnection sqlcon = new SqlConnection(con))
                {
                    sqlcon.Open();

                    // ================= 1. GET CART ITEMS =================
                    string cartQuery = @"
                SELECT 
                    ct.CourId,
                    c.CourPrice
                FROM CartTable ct
                INNER JOIN CourseTable c 
                    ON ct.CourId = c.CourId
                WHERE ct.UserId = @uid";

                    SqlCommand cmd = new SqlCommand(cartQuery, sqlcon);
                    cmd.Parameters.AddWithValue("@uid", userId);

                    SqlDataReader dr = cmd.ExecuteReader();

                    List<int> courseIds = new List<int>();
                    List<int> prices = new List<int>();

                    while (dr.Read())
                    {
                        courseIds.Add(Convert.ToInt32(dr["CourId"]));
                        prices.Add(Convert.ToInt32(dr["CourPrice"]));
                    }

                    dr.Close();

                    if (courseIds.Count == 0)
                    {
                        return BadRequest("Cart is empty");
                    }

                    // ================= 2. CALCULATE TOTAL =================
                    int total = 0;

                    for (int i = 0; i < prices.Count; i++)
                    {
                        total += prices[i];
                    }

                    // ================= 3. CREATE INVOICE =================
                    string invoiceQuery = @"
                INSERT INTO InvoiceTable (UserId, TotalAmount)
                VALUES (@uid, @total);
                SELECT SCOPE_IDENTITY();";

                    SqlCommand cmd2 = new SqlCommand(invoiceQuery, sqlcon);
                    cmd2.Parameters.AddWithValue("@uid", userId);
                    cmd2.Parameters.AddWithValue("@total", total);

                    int invoiceId = Convert.ToInt32(cmd2.ExecuteScalar());

                    // ================= 4. INSERT INVOICE DETAILS =================
                    for (int i = 0; i < courseIds.Count; i++)
                    {
                        string detailQuery = @"
                    INSERT INTO InvoiceDetails
                    (InvoiceId, CourId, CoursePrice)
                    VALUES (@iid, @cid, @price)";

                        SqlCommand cmd3 = new SqlCommand(detailQuery, sqlcon);

                        cmd3.Parameters.AddWithValue("@iid", invoiceId);
                        cmd3.Parameters.AddWithValue("@cid", courseIds[i]);
                        cmd3.Parameters.AddWithValue("@price", prices[i]);

                        cmd3.ExecuteNonQuery();
                    }

                    // ================= 5. CLEAR CART =================
                    string clearQuery = @"
                DELETE FROM CartTable 
                WHERE UserId = @uid";

                    SqlCommand cmd4 = new SqlCommand(clearQuery, sqlcon);
                    cmd4.Parameters.AddWithValue("@uid", userId);

                    cmd4.ExecuteNonQuery();

                    // ================= RESPONSE =================
                    return Ok(new
                    {
                        Message = "Purchase Successful",
                        InvoiceId = invoiceId
                    });
                }
            }
            catch (Exception ex)
            {
                return InternalServerError(ex);
            }
        }

        // ================= CLEAR CART =================

        [HttpDelete]
        [Route("Clear/{userid}")]
        public string ClearCart(int userid)
        {
            try
            {
                using (sqlcon = new SqlConnection(con))
                {
                    string query =
                        "DELETE FROM CartTable WHERE UserId=@uid";

                    sqlcmd = new SqlCommand(query, sqlcon);

                    sqlcmd.Parameters.AddWithValue("@uid", userid);

                    sqlcon.Open();

                    sqlcmd.ExecuteNonQuery();
                }

                return "Cart Cleared Successfully";
            }
            catch (Exception ex)
            {
                return ex.Message;
            }
        }
    }
